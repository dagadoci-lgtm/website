{
  "name": "drew-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tinacms dev -c \"next dev\"",
    "dev:next": "next dev",
    "build": "node scripts/build.mjs",
    "build:cloud": "tinacms build && next build",
    "build:local": "tinacms dev -c \"env NODE_ENV=production next build\"",
    "build:next": "next build",
    "start": "next start",
    "tina:validate": "node scripts/validate-tina-cloud.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tinacms/cli": "latest",
    "next": "^15.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tinacms": "latest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "latest",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.12.1"
}
